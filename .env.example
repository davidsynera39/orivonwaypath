# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only, never exposed to the browser. Used only in app/api routes that need
# to bypass RLS (e.g. admin tasks). Most routes should use the user's own session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq — console.groq.com/keys. Server-only, called from app/api/ai/route.js.
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b

# Stripe — leave blank until you're ready to launch payments.
# When set, lib/billing.js switches from the stub to real Stripe checkout.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI (`stripe listen`) for local dev, or the webhook's
# signing secret from the Stripe Dashboard once deployed. Required for
# app/api/stripe/webhook to verify incoming events.
STRIPE_WEBHOOK_SECRET=

# Shared secret checked by app/api/cron/scan-deadlines — set this if your
# scheduler isn't Vercel Cron (which authenticates itself automatically).
CRON_SECRET=
